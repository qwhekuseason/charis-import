{
  "name": "charis-import",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"CLIENT,SERVER\" -c \"cyan,magenta\" \"vite\" \"node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "seed": "node prisma/seed.js",
    "sync-images": "node prisma/sync-images.js",
    "set-password": "node prisma/set-password.js",
    "remove-demo-data": "node prisma/remove-demo-data.js",
    "push-keys": "node prisma/push-keys.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "build": "vite build",
    "preview": "vite preview",
    "prestart": "prisma db push --skip-generate || echo Database update skipped - run npm run db:push",
    "start": "node server/index.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "prisma": "^6.4.1",
    "vite": "^5.4.2"
  }
}
