# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-sample-host.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Port
PORT=5000

# JWT Authentication Secret — REQUIRED, random, 32+ characters. The server won't start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="your_secure_jwt_secret_here"

# Cloudinary Configuration
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"

# Customer emails (order updates and password-reset links). Optional, but without it
# "Forgot password?" tells customers to contact you on WhatsApp instead. Set ONE of:
#
#  1. BREVO_API_KEY — use this on Render's free plan, which blocks normal email (SMTP) ports.
#     Free Brevo account (brevo.com, 300 emails/day) → verify MAIL_FROM's address as a sender
#     (Senders, domains & dedicated IPs → Senders) → SMTP & API → API keys → Generate.
BREVO_API_KEY=""
#
#  2. SMTP_URL — only on hosts that allow outgoing SMTP (e.g. a paid Render plan).
#     Gmail: a 16-letter App Password (Google Account → Security → App passwords), never the
#     normal password. Write the @ as %40 and remove the spaces in the app password:
#       SMTP_URL="smtps://princessarmah514%40gmail.com:YOURAPPPASSWORD@smtp.gmail.com:465"
SMTP_URL=""
MAIL_FROM="CHARI <princessarmah514@gmail.com>"
# The live shop (the Render site, which has the server) — links inside emails open here.
SITE_URL="https://charis-import.onrender.com"
